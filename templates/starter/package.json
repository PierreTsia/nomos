{
  "name": "nomos-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A starter Nomos app — an ancillary consumer of @nomosui/react (ADR 0028, 0038).",
  "scripts": {
    "skin": "node scripts/skin.build.mjs",
    "predev": "npm run skin",
    "dev": "vite",
    "prebuild": "npm run skin",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nomosui/react": "^0.13.2",
    "@tanstack/react-table": "^9.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
