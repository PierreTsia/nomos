{
  "name": "@nomosui/react",
  "private": false,
  "version": "0.5.1",
  "type": "module",
  "description": "An app-agnostic design system, built in public: a core of tokens and components exposed to humans and agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/PierreTsia/nomos.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens/theme.css": "./tokens/theme.css",
    "./tokens/tokens.generated.css": "./tokens/tokens.generated.css",
    "./tokens/tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "dist",
    "tokens",
    "SKILL.md",
    "README.md",
    "scripts/install-skill.mjs"
  ],
  "bin": {
    "nomos-mcp": "./dist/mcp/bin.js",
    "nomos-skill": "./scripts/install-skill.mjs"
  },
  "scripts": {
    "mcp": "tsx src/mcp/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "build:view": "node scripts/build-view.mjs",
    "view:check": "node scripts/build-view.mjs --check",
    "build:view-css": "node scripts/build-view-css.mjs",
    "view-css:check": "node scripts/build-view-css.mjs --check",
    "build:surface": "tsx scripts/build-surface.ts",
    "surface:check": "tsx scripts/build-surface.ts --check",
    "build:package": "node scripts/build-package.mjs",
    "prepublishOnly": "npm run build:package",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
